# Copy to .env and edit. Every value here overrides the default in src/config.py.

# --- Data -------------------------------------------------------------------
RAW_DATA_DIR=data/raw
TRAIN_FILE=train.csv
VALIDATE_FILE=validate.csv
TEST_FILE=test.csv
# Leave blank to auto-detect (question/Question/query/input..., answer/Answer/response/output...)
QUESTION_COLUMN=
ANSWER_COLUMN=
ID_COLUMN=
SOURCE_COLUMN=

# --- Embeddings / vector store ---------------------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=64
EMBEDDING_DEVICE=
DISTANCE_METRIC=cosine
RAW_COLLECTION=medical_rag_raw
CLEANED_COLLECTION=medical_rag_cleaned

# --- Chunking / retrieval (identical for both pipelines) -------------------
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=10
CHUNK_FETCH_MULTIPLIER=3

# --- Cleaning ---------------------------------------------------------------
MIN_QUESTION_CHARS=10
MIN_ANSWER_CHARS=20
LOWERCASE_DOCUMENTS=false

# --- Leakage / evaluation ---------------------------------------------------
SEMANTIC_DUP_THRESHOLD=0.95
SEMANTIC_LEAK_THRESHOLD=0.90
EXCLUDE_LEAKED_EVAL_QUESTIONS=true
RANDOM_SEED=42
